<Window x:Class="Project_zhamo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Zhamo Launcher" Height="680" Width="600"
        Background="#1E1E1E">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="PROJECT ZHAMO" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,15"/>

            <!-- Account Configuration -->
            <TextBlock Text="Account Profile Name:" Foreground="LightGray" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtUsername" Text="ZhamoPlayer" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <!-- Folder Selection -->
            <Button x:Name="BtnSelectFolder" Content="Select Fortnite Game Folder (e.g., v24.20)" Height="35" Margin="0,5" Click="BtnSelectFolder_Click"/>
            <TextBlock x:Name="TxtFolderPath" Text="Folder: Not selected" Foreground="DarkGray" FontSize="11" Margin="5,0,0,10"/>

            <!-- Advanced Customization Files -->
            <TextBlock Text="Advanced Customization Files:" Foreground="LightGray" FontWeight="Bold" Margin="0,5,0,5"/>

            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtConsoleFile" Text="Console Unlocker" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                <Button x:Name="BtnBrowseConsole" Content="Browse..." Grid.Column="1" Width="70" Height="28" Margin="5,0,0,0" Click="BtnBrowseConsole_Click"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRedirectFile" Text="HTTP Traffic Redirector" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                <Button x:Name="BtnBrowseRedirect" Content="Browse..." Grid.Column="1" Width="70" Height="28" Margin="5,0,0,0" Click="BtnBrowseRedirect_Click"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtMemoryPatchFile" Text="Memory Patcher / Loader" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                <Button x:Name="BtnBrowseMemoryPatch" Content="Browse..." Grid.Column="1" Width="70" Height="28" Margin="5,0,0,0" Click="BtnBrowseMemoryPatch_Click"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInjectFile" Text="Server Injector / Backend Script" IsReadOnly="True" VerticalContentAlignment="Center" Height="28"/>
                <Button x:Name="BtnBrowseInject" Content="Browse..." Grid.Column="1" Width="70" Height="28" Margin="5,0,0,0" Click="BtnBrowseInject_Click"/>
            </Grid>

            <!-- Action Buttons -->
            <Button x:Name="BtnHostServer" Content="Host Server (Launch Injector)" Height="40" Margin="0,15,0,5" Background="#2D2D2D" Foreground="White" FontWeight="Bold" Click="BtnHostServer_Click"/>
            <Button x:Name="BtnLaunch" Content="Launch Project Zhamo" Height="45" Margin="0,5,0,10" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnLaunch_Click"/>

            <TextBlock x:Name="TxtStatus" Text="Status: Ready" Foreground="LightGreen" TextAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>